          <datasource-dependencies datasource='federated.1bgzuih0r40mx61ftbcry0qw20ls'>
            <column caption='KPI' datatype='string' name='[Calculation_1659694813564932]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [finding] = &apos;Hold rate&apos; AND [category] = &apos;All surfaces&apos; THEN &apos;1. Service games held&apos;&#10;ELSEIF [finding] = &apos;First to break wins the set&apos; AND [category] = &apos;All surfaces&apos; THEN &apos;2. First to break wins the set&apos;&#10;ELSEIF [finding] = &apos;Momentum effect&apos; THEN &apos;3. Momentum effect&apos;&#10;ELSEIF [finding] = &apos;Points won when the serve lands in&apos; AND [category] = &apos;First serve, body&apos; THEN &apos;4. Points won, first serve to the body&apos;&#10;END' />
              <aliases>
                <alias key='&quot;1. Service games held&quot;' value='Service games held' />
                <alias key='&quot;2. First to break wins the set&quot;' value='First to break wins the set' />
                <alias key='&quot;3. Momentum effect&quot;' value='Momentum effect' />
                <alias key='&quot;4. Points won, first serve to the body&quot;' value='Points won, first serve to the body' />
              </aliases>
            </column>
            <column caption='First Break Wins' datatype='real' name='[Calculation_1918286691487744]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[value]' />
            </column>
            <column caption='First Break Loses' datatype='real' name='[Calculation_1918286691602433]' role='measure' type='quantitative'>
