      <aliases enabled='yes' />
      <column datatype='string' name='[:Measure Names]' role='dimension' type='nominal'>
        <aliases>
          <alias key='&quot;[federated.06se0je1n4z15g1ed6zxt159hm93].[avg:break_back_rate:qk]&quot;' value='Break-Back Rate' />
          <alias key='&quot;[federated.06se0je1n4z15g1ed6zxt159hm93].[avg:first_body:qk]&quot;' value='First Body' />
          <alias key='&quot;[federated.06se0je1n4z15g1ed6zxt159hm93].[avg:first_serves:qk]&quot;' value='First Serves' />
          <alias key='&quot;[federated.06se0je1n4z15g1ed6zxt159hm93].[avg:first_t:qk]&quot;' value='First T' />
          <alias key='&quot;[federated.06se0je1n4z15g1ed6zxt159hm93].[avg:first_wide_t_entropy:qk]&quot;' value='First Wide/T Entropy' />
          <alias key='&quot;[federated.06se0je1n4z15g1ed6zxt159hm93].[avg:first_wide:qk]&quot;' value='First Wide' />
          <alias key='&quot;[federated.06se0je1n4z15g1ed6zxt159hm93].[avg:hold_rate:qk]&quot;' value='Hold Rate' />
          <alias key='&quot;[federated.06se0je1n4z15g1ed6zxt159hm93].[avg:serve_points_won:qk]&quot;' value='Serve Points Won' />
        </aliases>
      </column>
      <column caption='Share of Serves' datatype='real' default-format='p0.0%' name='[Calculation_1659694812155904]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([serves]) / TOTAL(SUM([serves]))'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Points Won When Landed' datatype='real' default-format='p0.0%' name='[Calculation_1659694812463105]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([won_when_landed]) / SUM([landed])' />
      </column>
      <column caption='Direction Label' datatype='string' name='[Calculation_1659694812540930]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [direction] WHEN &apos;wide&apos; THEN &apos;Wide&apos; WHEN &apos;body&apos; THEN &apos;Body&apos; ELSE &apos;T&apos; END' />
      </column>
      <column caption='Wide T First Serve Win Rate' datatype='real' name='[Calculation_2302360559271937]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([won_when_landed]) / SUM([landed])' />
      </column>
      <column caption='Pressure Effect (2)' datatype='real' name='[Calculation_2302360562425858]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='AVG([pressure_effect])' />
      </column>
      <column caption='Typical Wide' datatype='real' name='[Calculation_2302360569909253]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='ROUND(AVG([first_wide]) * 100, 0)' />
      </column>
      <column caption='Typical T' datatype='real' name='[Calculation_2302360569987078]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='ROUND(AVG([first_t]) * 100, 0)' />
      </column>
      <column caption='Wide T Split Display' datatype='string' name='[Calculation_2302360570048519]' role='measure' type='nominal'>
