      <column caption='Wide T Split Display' datatype='string' name='[Calculation_2302360570048519]' role='measure' type='nominal'>
        <calculation class='tableau' formula='STR([Calculation_2302360569909253]) + &quot;% / &quot; + STR([Calculation_2302360569987078]) + &quot;%&quot;' />
