            <column caption='Direction Label' datatype='string' name='[Calculation_1659694812540930]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [direction] WHEN &apos;wide&apos; THEN &apos;Wide&apos; WHEN &apos;body&apos; THEN &apos;Body&apos; ELSE &apos;T&apos; END' />
            </column>
            <column caption='Points Won Rate' datatype='real' name='[Calculation_2302360764555272]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([won_when_landed]) / SUM([landed])' />
