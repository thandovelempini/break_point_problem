    <worksheet name='First Break'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontcolor='#ffffff' fontsize='10' underline='true'>The First Break Usually Decides the Set</run>
            <run>Æ&#10;</run>
            <run fontcolor='#e6e6e6' fontsize='8'> Share of sets won by the first player to break</run>
          </formatted-text>
        </title>
        <caption>
          <formatted-text>
            <run>10,827 completed sets with a break

</run>
          </formatted-text>
        </caption>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='Findings' name='federated.1bgzuih0r40mx61ftbcry0qw20ls' />
          </datasources>
          <datasource-dependencies datasource='federated.1bgzuih0r40mx61ftbcry0qw20ls'>
            <column caption='KPI' datatype='string' name='[Calculation_1659694813564932]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [finding] = &apos;Hold rate&apos; AND [category] = &apos;All surfaces&apos; THEN &apos;1. Service games held&apos;&#10;ELSEIF [finding] = &apos;First to break wins the set&apos; AND [category] = &apos;All surfaces&apos; THEN &apos;2. First to break wins the set&apos;&#10;ELSEIF [finding] = &apos;Momentum effect&apos; THEN &apos;3. Momentum effect&apos;&#10;ELSEIF [finding] = &apos;Points won when the serve lands in&apos; AND [category] = &apos;First serve, body&apos; THEN &apos;4. Points won, first serve to the body&apos;&#10;END' />
              <aliases>
                <alias key='&quot;1. Service games held&quot;' value='Service games held' />
                <alias key='&quot;2. First to break wins the set&quot;' value='First to break wins the set' />
                <alias key='&quot;3. Momentum effect&quot;' value='Momentum effect' />
                <alias key='&quot;4. Points won, first serve to the body&quot;' value='Points won, first serve to the body' />
              </aliases>
            </column>
            <column caption='First Break Wins' datatype='real' name='[Calculation_1918286691487744]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[value]' />
            </column>
            <column caption='First Break Loses' datatype='real' name='[Calculation_1918286691602433]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='1 - [value]' />
            </column>
            <column caption='Category' datatype='string' name='[category]' role='dimension' type='nominal' />
            <column caption='Finding' datatype='string' name='[finding]' role='dimension' type='nominal' />
            <column-instance column='[Calculation_1659694813564932]' derivation='None' name='[none:Calculation_1659694813564932:nk]' pivot='key' type='nominal' />
            <column-instance column='[Calculation_1918286691487744]' derivation='Sum' name='[sum:Calculation_1918286691487744:qk]' pivot='key' type='quantitative' />
            <column-instance column='[Calculation_1918286691602433]' derivation='Sum' name='[sum:Calculation_1918286691602433:qk]' pivot='key' type='quantitative' />
            <column caption='Value' datatype='real' name='[value]' role='measure' type='quantitative' />
          </datasource-dependencies>
          <filter class='categorical' column='[federated.1bgzuih0r40mx61ftbcry0qw20ls].[:Measure Names]'>
            <groupfilter function='union' user:op='manual'>
