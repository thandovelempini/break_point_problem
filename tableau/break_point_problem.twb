        <zone forceUpdate='true' h='6651' id='15' type-v2='text' w='96920' x='1711' y='1935'>
          <formatted-text>
            <run bold='true' fontcolor='#af78f2' fontsize='15'>MOMENTUM</run>
          </formatted-text>
          <zone-style>
            <format attr='border-color' value='#1d233a' />
            <format attr='border-style' value='solid' />
            <format attr='border-width' value='1' />
            <_.fcp.DashboardRoundedCorners.true...format attr='corner-radius' value='7' />
