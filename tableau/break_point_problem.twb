        <zone forceUpdate='true' h='6143' id='16' type-v2='text' w='96166' x='1704' y='8477'>
          <formatted-text>
            <run bold='true' fontcolor='#ffffff' fontsize='10'>What actually decides a service game when the serve isn&apos;t overwhelmingly dominant?</run>
            <run>Æ&#10;</run>
            <run fontcolor='#e6e6e6'>WTA Grand Slam singles • 2011-2024 • 723K points • 101K service games</run>
          </formatted-text>
